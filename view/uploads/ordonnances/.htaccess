# Protection du dossier ordonnances
# Autoriser uniquement PDF et images

<FilesMatch "\.(pdf|jpg|jpeg|png|gif)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Bloquer l'exécution de scripts PHP
<FilesMatch "\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Désactiver l'affichage des dossiers
Options -Indexes